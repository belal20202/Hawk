class_name PrivacyText
extends RefCounted
## نص سياسة الخصوصية داخل اللعبة (يتوافق مع متطلبات Google Play وApp Store).
## نفس النص موجود في docs/privacy.html لرابط السياسة العام المطلوب عند رفع اللعبة على المتاجر.
## ضع بريدك الإلكتروني في CONTACT_EMAIL ليظهر قسم «التواصل» كاملاً.

const UPDATED := "نوفمبر 2026"
const DEVELOPER := "بلال"
const CONTACT_EMAIL := ""

const SECTIONS := [
	["مقدمة", "«صقور الرافدين» لعبة استراتيجية حربية ثلاثية الأبعاد من تطوير وتصميم بلال. نحترم خصوصيتك، واللعبة مصممة لتعمل كلياً على جهازك دون جمع أي بيانات شخصية عنك."],
	["البيانات التي نجمعها", "لا نجمع أي بيانات شخصية إطلاقاً: لا اسم، ولا بريد إلكتروني، ولا رقم هاتف، ولا موقع جغرافي، ولا معرّف إعلانات، ولا صور، ولا جهات اتصال، ولا حسابات. لا يوجد تسجيل دخول ولا حسابات مستخدمين."],
	["ما يُخزَّن على جهازك فقط", "تحفظ اللعبة على جهازك فقط: إعدادات الصوت والرسوميات، والمباريات التي تحفظها بنفسك من قائمة الإيقاف. لا يوجد حفظ تلقائي: لا تُحفظ مباراتك إلا حين تضغط على أزرار الحفظ. هذه الملفات لا تُرسَل إلى أي جهة، وتبقى في مساحة اللعبة الخاصة على جهازك."],
	["الإنترنت والإعلانات والأطراف الثالثة", "اللعبة تعمل بلا اتصال بالإنترنت ولا تطلب إذن الإنترنت. لا تحتوي على إعلانات، ولا أدوات تحليل أو تتبع، ولا مشتريات داخل التطبيق، ولا خدمات أطراف ثالثة تجمع بياناتك، ولا شبكات اجتماعية."],
	["الأذونات", "لا تطلب اللعبة أي إذن حساس: لا الموقع ولا الكاميرا ولا الميكروفون ولا جهات الاتصال ولا التخزين الخارجي ولا الإشعارات."],
	["الأطفال", "اللعبة مناسبة لجميع الأعمار ولا تجمع أي معلومات من أي مستخدم، بمن فيهم الأطفال دون 13 عاماً، وبذلك تتوافق مع قوانين حماية خصوصية الأطفال (مثل COPPA وGDPR-K). تحتوي اللعبة على قتال خيالي بلا دماء أو ألفاظ نابية. ننصح أولياء الأمور بمراجعة المحتوى بما يناسب أطفالهم."],
	["سجل التشغيل", "قد تحفظ اللعبة سجلاً تقنياً محلياً على جهازك لمساعدتك في تشخيص الأعطال. لا يُرسَل تلقائياً، ولا يُشارَك إلا إذا نسخته أنت بنفسك وأرسلته."],
	["حقوقك وحذف بياناتك", "بياناتك كلها على جهازك وتحت سيطرتك. يمكنك حذف أي مباراة محفوظة من قائمة «المحفوظات»، أو حذف كل بيانات اللعبة بإلغاء تثبيتها أو بمسح بياناتها من إعدادات الهاتف. وبما أننا لا نجمع شيئاً، فلا توجد بيانات لدينا لنصل إليها أو نعدّلها أو نحذفها."],
	["الأمان", "لأن اللعبة لا ترسل ولا تستقبل أي بيانات عبر الشبكة، لا توجد بيانات معرضة للتسريب من جهتنا."],
	["التغييرات على هذه السياسة", "قد نحدّث هذه السياسة عند إضافة ميزات جديدة. سنذكر تاريخ آخر تحديث في أعلى الصفحة، وإن تغيرت طريقة التعامل مع البيانات فسنخبرك قبل تطبيق ذلك."],
]


static func contact_text() -> String:
	if CONTACT_EMAIL != "":
		return "للاستفسار عن الخصوصية راسل المطوّر بلال على: " + CONTACT_EMAIL
	return "للاستفسار عن الخصوصية تواصل مع المطوّر بلال عبر صفحة المشروع على GitHub."


static func full_text() -> String:
	var out := ""
	for s in SECTIONS:
		out += str(s[0]) + "\n" + str(s[1]) + "\n\n"
	out += "التواصل\n" + contact_text()
	return out
